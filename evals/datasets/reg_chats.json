        {"ran": ["ticket_operator"], "facts": {"operator_action": "offer", "validation": "pass"}, "pending": "offer", "created": 0, "language": "ar"},
        {"ran": ["ticket_operator"], "facts": {"operator_action": "request_detail", "validation": "pass"}, "pending": "detail", "created": 0, "language": "ar"},
        {"not_ran": ["search"], "facts": {"validation": "pass"}, "pending": "detail", "created": 0, "language": "ar"},
        {"ran": ["ticket_operator"], "facts": {"operator_action": "request_detail", "validation": "pass"}, "pending": "detail", "created": 0, "language": "ar"},
        {"ran": ["ticket_operator"], "facts": {"operator_action": "show_summary", "validation": "pass"}, "pending": "summary", "created": 0, "language": "ar"},
        {"ran": ["ticket_operator"], "facts": {"operator_action": "show_summary", "validation": "pass"}, "pending": "summary", "created": 0, "draft_unknown_excludes": ["error text or screenshot"], "language": "ar"},
        {"ran": ["ticket_operator"], "facts": {"operator_action": "submitted", "validation": "pass"}, "must_have": [["T-"]], "pending": null, "created": 1, "queued": 0, "tickets_include": ["ERORORO"], "language": "ar"}]}},

