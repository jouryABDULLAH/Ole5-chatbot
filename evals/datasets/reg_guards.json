    {
      "id": "self-offer",
      "input": {
        "guard": "validate",
        "reply": "أنواع التنبيهات هي الرسائل القصيرة والبريد الإلكتروني. هل ترغب بفتح تذكرة دعم؟",
        "state": {
          "messages": [
            {
              "role": "user",
              "content": "السلام عليكم"
            }
          ],
          "language": "ar",
          "intent": "question",
          "search_outcome": "answered",
          "current_references": [
            {
              "text": "نافذة إضافة تنبيه للإجراء الحقول:\n\nنوع التنبيه — إجباري، مثل \"تنبيه بقرب انتهاء الوقت\".\nوقت التنبيه — بعد عدد أيام من تاريخ استقبالها، إجباري.\nنوع التنبيهات — الرسائل القصيرة، البريد الإلكتروني.\n\nملاحظة تظهر في النافذة: جميع الإجراءات هامة، والتنبيه بقرب انتهاء المدة يجب أن يكون بتاريخ ووقت داخل تاريخ ووقت اعتبار المراسلة متأخرة.",
              "document": "دليل استخدام نظام OLE5 — الإجراءات والشاشات",
              "relation": "DIRECT"
            }
          ]
        }
      },
      "expected": {
        "validation": "repair"
      }
    },
