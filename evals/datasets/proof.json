      "expected": {"turns": [{"not_ran": ["search", "ticket_operator", "ticket_enquiry"], "facts": {"intent": "other", "validation": "pass"}, "must_have": [["وعليكم السلام"]], "pending": null, "created": 0, "language": "ar"}]}},
    {"id": "capabilities-ar",
