      "expected": {"turns": [{"not_ran": ["search", "ticket_operator", "ticket_enquiry"], "facts": {"intent": "other", "validation": "pass"}, "must_have": [["تذكرة", "تذاكر"]], "pending": null, "created": 0, "language": "ar"}]}},
