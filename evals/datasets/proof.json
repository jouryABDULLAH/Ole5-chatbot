        {"ran": ["ticket_operator"], "facts": {"operator_action": "request_detail", "validation": "pass"}, "pending": "detail", "created": 0, "language": "ar"},
        {"ran": ["ticket_operator"], "facts": {"operator_action": "request_detail", "validation": "pass"}, "pending": "detail", "created": 0, "language": "ar"},
