    {
      "id": "new-ticket-does-not-reuse-earlier-details",
      "input": {
        "turns": [
          "زر الارشفة ما يشتغل",
          "ما ضبطت معي",
          "نعم",
          "لا اعلم",
          "ERROR404",
          "نعم",
          "ولا موظف عندنا يقدر يسجل دخول من الصباح",
          "نعم"
        ]
      },
      "expected": {
        "turns": [
          {},
          {},
          {},
          {},
          {},
          {
            "pending": null,
            "created": 1,
            "queued": 0,
            "tickets_include": ["ERROR404"]
          },
          {
            "created": 1,
            "queued": 0
          },
          {
            "pending": "summary",
            "created": 1,
            "queued": 0,
            "draft_excludes": ["ERROR404"],
            "draft_unknown_excludes": ["page"],
            "must_not": ["قائمة الانتظار"]
          }
        ]
      }
    },
    {
      "id": "explicit-ticket-after-answer",
      "input": {
        "turns": [
          "كيف انشئ مراسلة داخلية",
          "ما فهمت",
          "افتح لي تذكرة عن  انشاء مراسلة داخلية"
        ]
      },
      "expected": {
        "turns": [
          {
            "ran": ["search"],
            "facts": {"search_outcome": "answered"}
          },
          {},
          {
            "ran": ["ticket_operator"],
            "facts": {"explicit_ticket_request": true},
            "pending": ["offer", "detail", "summary"],
            "must_not": ["لم أتمكن من العثور", "لم أستطع العثور"]
          }
        ]
      }
    },
    {
